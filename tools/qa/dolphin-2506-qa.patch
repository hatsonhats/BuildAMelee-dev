   u32 exceptions = m_ppc_state.Exceptions;
 
+  // Headless QA: say where a crash came from (PC, LR and the back chain).
+  if ((exceptions & (EXCEPTION_ISI | EXCEPTION_DSI | EXCEPTION_PROGRAM)) &&
+      std::getenv("DOLPHIN_NO_ALERTS") != nullptr)
+  {
+    auto& memory = m_system.GetMemory();
+    u32 sp = m_ppc_state.gpr[1];
+    std::string chain;
+    for (int i = 0; i < 16 && sp >= 0x80000000 && sp < 0x81800000; ++i)
+    {
+      const u32 lr = memory.Read_U32((sp + 4) & 0x01FFFFFF);
+      chain += fmt::format(" {:08x}", lr);
+      sp = memory.Read_U32(sp & 0x01FFFFFF);
+    }
+    NOTICE_LOG_FMT(POWERPC, "QA-CRASH exc={:x} pc={:08x} npc={:08x} lr={:08x} dar={:08x} r3={:08x} r4={:08x} r31={:08x} chain:{}",
+                   exceptions, m_ppc_state.pc, m_ppc_state.npc, LR(m_ppc_state), m_ppc_state.spr[SPR_DAR],
+                   m_ppc_state.gpr[3], m_ppc_state.gpr[4], m_ppc_state.gpr[31], chain);
+  }
+
